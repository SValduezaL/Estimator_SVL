# Nombre de la API
APP_NAME=Estimador CAG API

# Entorno: dev | staging | prod
APP_ENV=dev

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Proveedor LLM: openai | anthropic
LLM_PROVIDER=anthropic

# Lista de modelos permitidos por proveedor (JSON)
LLM_MODELS_BY_PROVIDER={"openai":["gpt-4o-mini","gpt-4.1-mini"],"anthropic":["claude-haiku-4-5","claude-3-5-haiku-latest"]}

# Modelo según proveedor
# OpenAI: gpt-4o-mini
# Anthropic: claude-haiku-4-5
LLM_MODEL=gpt-4o-mini

# Completa solo la key del proveedor elegido
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Hiperparametros de generacion
TEMPERATURE=0.2
MAX_TOKENS=800

# Caché Redis (opcional): estimaciones idénticas reutilizan respuesta sin llamar al LLM.
# En docker-compose-dev.yml el servicio `estimator` ya define REDIS_URL hacia `redis`.
# En local sin Redis, deja vacío o comenta la variable.
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_TTL_SECONDS=86400

# LiteLLM / Router (opcional)
# LLM_FALLBACK_MODEL=claude-haiku-4-5
# LLM_TIMEOUT_SECONDS=120
# LLM_NUM_RETRIES=2

# Streamlit (cliente HTTP hacia esta API; por defecto http://localhost:8000)
# ESTIMATOR_API_BASE_URL=http://localhost:8000
