# Nombre de la API
APP_NAME=Estimador CAG API

# Entorno: dev | staging | prod
APP_ENV=dev

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Proveedor LLM: openai | anthropic
LLM_PROVIDER=anthropic

# Lista de modelos permitidos por proveedor (JSON)
LLM_MODELS_BY_PROVIDER={"openai":["gpt-4o-mini","gpt-4.1-mini"],"anthropic":["claude-haiku-4-5","claude-3-5-haiku-latest"]}

# Modelo según proveedor
# OpenAI: gpt-4o-mini
# Anthropic: claude-haiku-4-5
LLM_MODEL=gpt-4o-mini

# Completa solo la key del proveedor elegido
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Hiperparametros de generacion
TEMPERATURE=0.2
MAX_TOKENS=800

# --- Session 3 — LiteLLM wrapper (opcional) ----------------------------------------------
# El wrapper intenta usar PRIMARY_MODEL primero y recurre a FALLBACK_MODEL en caso de fallo,
# con hasta LLM_RETRIES intentos y un plazo límite de LLM_TIMEOUT segundos.
# PRIMARY_MODEL=gpt-4o-mini
# FALLBACK_MODEL=claude-haiku-4-5-20251001
# LLM_TIMEOUT=30
# LLM_RETRIES=2

# --- Session 3 — Redis exact-match cache --------------------------------------
# Dentro de docker-compose, REDIS_URL se sobrescribe a redis://redis:6379.
# Al ejecutar uvicorn localmente (fuera de Docker), use redis://localhost:6379.
# REDIS_URL=redis://redis:6379
# CACHE_TTL_SECONDS=86400

# --- Session 3 — Redis exact-match cache (opcional) --------------------------------------
# En docker-compose-dev.yml el servicio `estimator` ya define REDIS_URL hacia `redis`.
# En local sin Redis, deja vacío o comenta la variable.
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_TTL_SECONDS=86400

# --- Session 3 — Streamlit transport (opcional) ------------------------------------------
# Streamlit accede al servicio FastAPI a través de HTTP. Indique aquí dónde se puede
# acceder al estimador desde la máquina que ejecuta streamlit_app.py.
ESTIMATOR_API_BASE_URL=http://localhost:8000

# --- Session 4 — Semantic cache (redisvl + embeddings) ------------------------
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_MAX_RESULTS=3
SEMANTIC_EMBEDDING_PROVIDER=openai
SEMANTIC_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_EMBEDDING_DIMENSIONS=1536
# Umbral de similitud del coseno (0..1) por encima del cual una estimación almacenada
# se sirve como acierto de caché. 0.92 es un valor conservador; un umbral menor implica
# mayor recall y más falsos positivos. Es afín al modelo de incrustación elegido.
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=86400
# Cuando es verdadero, la caché registra los posibles accesos pero NO los sirve;
# esto es útil para calibrar el umbral con el tráfico de producción antes de activarlo.
SEMANTIC_CACHE_LOG_ONLY=false

# --- Session 4 — Guardrails (defense-in-depth) (opcional)---------------------------
# GUARDRAILS_ENABLED=true
# GUARDRAILS_MODERATION_ENABLED=true
# GUARDRAILS_INJECTION_ENABLED=true
# GUARDRAILS_PII_INPUT_ENABLED=true
# GUARDRAILS_PII_OUTPUT_ENABLED=true
# GUARDRAILS_OUTPUT_SEMANTIC_ENABLED=true
# GUARDRAILS_MODERATION_LOG_ONLY=false
# GUARDRAILS_INJECTION_LOG_ONLY=false
# GUARDRAILS_PII_INPUT_LOG_ONLY=false
# GUARDRAILS_FAIL_OPEN_ON_MODERATION_ERROR=true
# GUARDRAILS_OUTPUT_MAX_RETRIES=1
# GUARDRAILS_MODERATION_THRESHOLDS={}

# --- Session 7 — Embeddings (monolito, POST /embeddings/ingest en :8000) --------
# Requiere OPENAI_API_KEY para ingest y compare de estrategias de chunking.