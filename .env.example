# =============================================================================
# Estimador CAG + RAG — plantilla de variables de entorno
# Copia a .env y completa tus claves. Valores mostrados = defaults de app/config.py
# Documentación completa: README.md
# =============================================================================

# --- Core --------------------------------------------------------------------

APP_NAME=Estimador CAG RAG API
APP_ENV=dev
LOG_LEVEL=DEBUG

# --- LLM ---------------------------------------------------------------------

# Proveedor activo: openai | anthropic
LLM_PROVIDER=openai

# Modelos permitidos por proveedor (JSON). LLM_MODEL debe estar en la lista del proveedor activo.
LLM_MODELS_BY_PROVIDER={"openai":["gpt-4o-mini","gpt-4.1-mini"],"anthropic":["claude-haiku-4-5","claude-3-5-haiku-latest"]}

# Modelo principal (debe pertenecer al proveedor elegido arriba)
LLM_MODEL=gpt-4o-mini

# Completa solo la key del proveedor activo (y del fallback si aplica)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

TEMPERATURE=0.2
MAX_TOKENS=2000

# Fallback LiteLLM (opcional). Si se define, se exige API key del proveedor del fallback.
LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=30
LLM_NUM_RETRIES=2

# --- Caché Redis (exacta) ----------------------------------------------------
# Vacío = sin caché. En docker-compose-dev.yml el servicio `estimator` inyecta
# REDIS_URL=redis://redis:6379/0 automáticamente.
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_TTL_SECONDS=86400

# --- Caché semántica (Redis Stack + embeddings) ----------------------------

SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_LOG_ONLY=false
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_RESULTS=3
SEMANTIC_CACHE_INDEX_NAME=estimations_v1
SEMANTIC_CACHE_KEY_PREFIX=estimation:semantic:v1
SEMANTIC_EMBEDDING_PROVIDER=openai
SEMANTIC_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_EMBEDDING_DIMENSIONS=1536

# --- Guardrails (defense-in-depth) -------------------------------------------
# Descomenta para sobrescribir defaults. En tests: GUARDRAILS_ENABLED=false

# GUARDRAILS_ENABLED=true
# GUARDRAILS_MODERATION_ENABLED=true
# GUARDRAILS_INJECTION_ENABLED=true
# GUARDRAILS_PII_INPUT_ENABLED=true
# GUARDRAILS_PII_OUTPUT_ENABLED=true
# GUARDRAILS_OUTPUT_SEMANTIC_ENABLED=true
# GUARDRAILS_MODERATION_LOG_ONLY=false
# GUARDRAILS_INJECTION_LOG_ONLY=false
# GUARDRAILS_PII_INPUT_LOG_ONLY=false
# GUARDRAILS_MODERATION_MODEL=omni-moderation-latest
# GUARDRAILS_MODERATION_THRESHOLDS={}
# GUARDRAILS_INJECTION_PATTERN_VERSION=v1
# GUARDRAILS_FAIL_OPEN_ON_MODERATION_ERROR=true
# GUARDRAILS_OUTPUT_MAX_RETRIES=1
# GUARDRAILS_JUDGE_ENABLED=false
# GUARDRAILS_MIN_EUR_PER_HOUR=20
# GUARDRAILS_MAX_EUR_PER_HOUR=250
# GUARDRAILS_HOURS_PER_WEEK=40
# GUARDRAILS_PROMPT_MAX_CHARS=120000

# --- Memoria conversacional --------------------------------------------------

# MEMORY_ANCHORS_ENABLED=true
# MEMORY_ANCHORS_MAX_ITEMS=20
# MEMORY_SUMMARY_ENABLED=true
# MEMORY_SUMMARY_MAX_CHARS=4000
# MEMORY_SUMMARY_MODEL=gpt-4o-mini
# MEMORY_SUMMARY_TIMEOUT_SECONDS=60
# MEMORY_SUMMARY_MAX_RETRIES=1
# TIER_RULES_ENABLED=true

# --- Adjuntos (multipart POST /sessions/{id}/estimate) -----------------------
# Formatos soportados: .pdf, .docx

# ATTACHMENTS_ENABLED=true
# ATTACHMENTS_MAX_FILES=5
# ATTACHMENTS_MAX_FILE_SIZE_MB=10
# ATTACHMENTS_MAX_CHARS_PER_FILE=12000

# --- Streamlit (corre en el host, no en Docker) ------------------------------

ESTIMATOR_API_BASE_URL=http://localhost:8000

# --- PostgreSQL + pgvector (S8) ----------------------------------------------
# En docker-compose.yml el servicio `estimator` inyecta DATABASE_URL automáticamente.
# DATABASE_URL=postgresql+asyncpg://estimator:estimator@localhost:5432/estimator

# --- RAG / Embeddings S7 (monolito :8000) ------------------------------------
# POST /embeddings/ingest y POST /embeddings/compare requieren OPENAI_API_KEY.
